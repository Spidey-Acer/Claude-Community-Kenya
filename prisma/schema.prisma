// Claude Community Kenya — Prisma Schema
// Prisma 7.x format: datasource URL configured in prisma.config.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  MEMBER
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum SpeakerCategory {
  FINTECH
  TECHNICAL
  CAREER
  LIVE_DEMO
  OTHER
}

enum ProjectStage {
  IDEA
  MVP
  GROWING
}

enum EventType {
  MEETUP
  WORKSHOP
  CAREER_TALK
  HACKATHON
  CONFERENCE
}

enum EventStatus {
  UPCOMING
  REGISTRATION_OPEN
  SOLD_OUT
  COMPLETED
  CANCELLED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum CommunityResourceType {
  MCP
  PROMPT
  WORKFLOW
  TOOL
}

enum CommunityStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Audience {
  dev
  non_tech_pro
  student
  founder
  creator
}

enum Intent {
  learn_basics
  find_event
  find_collaborators
  build
  hire_or_partner
  other
}

enum Experience {
  never_used
  claude_ai
  claude_code
  api_builder
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  passwordHash             String
  role                     UserRole  @default(MEMBER)
  firstName                String
  lastName                 String
  phone                    String?
  imageUrl                 String?
  active                   Boolean   @default(true)
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  lastLogin                DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Submissions linked back to this user (when authored while signed in)
  ideaSubmissions      IdeaSubmission[]
  communitySubmissions CommunitySubmission[]
  joinApplications     JoinApplication[]
  speakerApplications  SpeakerApplication[]
  volunteerApplications VolunteerApplication[]
  demoRequests         DemoRequest[]
  onboardingSessions   OnboardingSession[]

  @@map("users")
}

// ─── Speaker Applications ────────────────────────────────────────────────────

model SpeakerApplication {
  id             String            @id @default(cuid())
  userId         String?
  name           String
  email          String
  phone          String?
  topic          String
  abstract       String            @db.Text
  bio            String            @db.Text
  category       SpeakerCategory
  preferredEvent String?
  preferredCity  String?
  linkedIn       String?
  github         String?
  portfolio      String?
  website        String?
  status         ApplicationStatus @default(PENDING)
  reviewedBy     String?
  reviewNotes    String?           @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("speaker_applications")
}

// ─── Idea / Project Submissions ──────────────────────────────────────────────

model IdeaSubmission {
  id           String            @id @default(cuid())
  userId       String?
  title        String
  description  String            @db.Text
  stage        ProjectStage
  seekingRoles Json              // Array: COFOUNDER | DEVELOPER | DESIGNER | MENTOR | FUNDER
  techStack    Json?             // Array of strings
  timeline     String?
  contactName  String
  contactEmail String
  linkedIn     String?
  github       String?
  website      String?
  status       ApplicationStatus @default(PENDING)
  reviewedBy   String?
  reviewNotes  String?           @db.Text
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("idea_submissions")
}

// ─── Join Applications ───────────────────────────────────────────────────────

model JoinApplication {
  id              String            @id @default(cuid())
  userId          String?
  name            String
  email           String
  github          String?
  experience      String            @db.Text
  interests       Json              // Array of strings
  reason          String            @db.Text
  heardFrom       String?
  // Karibu attribution (populated when the applicant came through the onboarding chat)
  karibuAudience  Audience?
  karibuIntent    Intent?
  karibuSessionId String?
  status          ApplicationStatus @default(PENDING)
  reviewedBy      String?
  reviewNotes     String?           @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([karibuAudience])
  @@map("join_applications")
}

// ─── Demo Requests ───────────────────────────────────────────────────────────

model DemoRequest {
  id            String            @id @default(cuid())
  userId        String?
  eventId       String
  name          String
  email         String
  projectTitle  String
  description   String            @db.Text
  estimatedTime String
  demoUrl       String?
  repoUrl       String?
  status        ApplicationStatus @default(PENDING)
  displayOrder  Int?
  reviewedBy    String?
  reviewNotes   String?           @db.Text
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([userId])
  @@map("demo_requests")
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String      @db.Text
  fullDescription String?     @db.Text
  date            DateTime
  time            String
  venue           String
  city            String
  type            EventType
  status          EventStatus @default(UPCOMING)
  registrationUrl String?
  lumaUrl         String?
  host            String?
  partnerOrg      String?
  highlights      Json?       // String[]
  agenda          Json?       // String[]
  attendeeCount   Int?
  posterUrl       String?
  photosUrl       String?
  recordingUrl    String?
  slidesUrl       String?
  prizes          Json?       // String[]
  rules           Json?       // String[]
  featured        Boolean     @default(false)
  audiences       Audience[]  @default([])
  intents         Intent[]    @default([])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("events")
}

// ─── Blog Posts ──────────────────────────────────────────────────────────────

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String     @db.Text
  content     String     @db.Text
  author      String
  authorId    String?
  tags        Json       // String[]
  publishedAt DateTime?
  featured    Boolean    @default(false)
  status      BlogStatus @default(DRAFT)
  views       Int        @default(0)
  readingTime Int?
  audiences   Audience[] @default([])
  intents     Intent[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("blog_posts")
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  builder     String
  description String   @db.Text
  stack       Json     // String[]
  status      String?
  demoUrl     String?
  repoUrl      String?
  featured     Boolean    @default(false)
  audiences    Audience[] @default([])
  contactName  String?
  contactEmail String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("projects")
}

// ─── Team Members ────────────────────────────────────────────────────────────

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String   @db.Text
  linkedIn  String?
  github    String?
  twitter   String?
  website   String?
  avatar    String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// ─── Contact Messages ────────────────────────────────────────────────────────

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String        @db.Text
  status      MessageStatus @default(UNREAD)
  repliedAt   DateTime?
  replyText   String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("contact_messages")
}

// ─── Site Settings ──────────────────────────────────────────────────────────

model SiteSettings {
  id               String   @id @default("default")
  discordMembers   Int      @default(0)
  whatsappMembers  Int      @default(0)
  linkedinMembers  Int      @default(0)
  eventsHeld       Int      @default(0)
  citiesActive     Json     @default("[\"Nairobi\", \"Mombasa\"]") // String[]
  resourceCount    Int      @default(0)
  websiteStatus    String   @default("live")
  updatedAt        DateTime @updatedAt

  @@map("site_settings")
}

// ─── Volunteer Applications ─────────────────────────────────────────────────

enum VolunteerRole {
  SOCIAL_MEDIA_MANAGER
  COMMUNITY_MANAGER
  CONTENT_CREATOR
  EVENT_COORDINATOR
}

model VolunteerApplication {
  id           String            @id @default(cuid())
  userId       String?
  name         String
  email        String
  phone        String?
  role         VolunteerRole
  experience   String            @db.Text
  availability String
  motivation   String            @db.Text
  linkedIn     String?
  github       String?
  twitter      String?
  portfolio    String?
  status       ApplicationStatus @default(PENDING)
  reviewedBy   String?
  reviewNotes  String?           @db.Text
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("volunteer_applications")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   // Plain string — not a FK. May be "system" for automated actions.
  userName  String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Community Hub ──────────────────────────────────────────────────────────

model CommunitySubmission {
  id                  String                @id @default(cuid())
  userId              String?
  slug                String                @unique
  type                CommunityResourceType
  title               String
  shortDescription    String                @db.Text
  fullDescription     String                @db.Text
  url                 String?
  repoUrl             String?
  installInstructions String?               @db.Text
  tags                Json                  // String[]
  submitterName       String?
  submitterContact    String?
  status              CommunityStatus       @default(PENDING)
  reviewedBy          String?
  reviewNotes         String?               @db.Text
  reviewedAt          DateTime?
  upvoteCount         Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  user     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  comments CommunityComment[]
  upvotes  CommunityUpvote[]

  @@index([status])
  @@index([type])
  @@index([userId])
  @@index([status, type])
  @@map("community_submissions")
}

model CommunityComment {
  id           String          @id @default(cuid())
  submissionId String
  authorName   String?
  content      String          @db.Text
  status       CommunityStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  submission CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, status])
  @@map("community_comments")
}

model CommunityUpvote {
  id           String   @id @default(cuid())
  submissionId String
  ipHash       String
  createdAt    DateTime @default(now())

  submission CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, ipHash])
  @@map("community_upvotes")
}

// ─── Karibu Onboarding ───────────────────────────────────────────────────────

model OnboardingSession {
  id           String      @id @default(cuid())

  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookieId     String?     @unique

  audience     Audience?
  intent       Intent?
  experience   Experience?

  name         String?
  city         String?
  language     String?

  conversation Json?
  skipped      Boolean     @default(false)
  completedAt  DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([cookieId])
  @@index([userId])
  @@index([audience])
  @@map("onboarding_sessions")
}

// ─── Newsletter ──────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}
