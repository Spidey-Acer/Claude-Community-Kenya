# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.claudekenya.org

# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (Transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL for Prisma migrations (port 5432, no pgbouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Supabase Storage ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://www.claudekenya.org"
# For local development use: http://localhost:3000

# ─── CSRF ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CSRF_SECRET="your-csrf-secret-here"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@claudekenya.org"
EMAIL_FROM_NAME="Claude Community Kenya"
EMAIL_TO_ADMIN="claudecommunitykenya@gmail.com"

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────────────────
# Optional in development — required in production
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxx"

# ─── Community Hub ───────────────────────────────────────────────────────────
UPVOTE_SALT="your-random-salt-here"

# Karibu onboarding feature flag (false = no modal, generic homepage)
KARIBU_ENABLED=false
# Canary percentage for week 1 rollout (0-100). 100 = full rollout.
KARIBU_CANARY_PCT=100

# Karibu daily cron secret — Vercel cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# ─── Impact Lab ───────────────────────────────────────────────────────────────
# Which cohort is running, and its lifecycle status (DRAFT/LIVE/CLOSED/
# ARCHIVED), now live in the database (the Event table) — set from Admin →
# Impact Lab → Events tab, not here. No env var to configure. See
# docs/impact-lab/16-running-another-event.md.